<base:WindowBase
    x:Class="v2rayN.Views.SubSettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tr="clr-namespace:v2rayN.Markup"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuSubSetting}"
    Width="1000"
    Height="700"
    x:TypeArguments="vms:SubSettingViewModel"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!-- DialogHost 保留：分享订阅时会用它弹出二维码视图（标识符 SubDialog 不能改） -->
    <materialDesign:DialogHost
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        Identifier="SubDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 操作 -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource P2rayH1}" Text="{x:Static resx:ResUI.menuSubSetting}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource P2rayMicro}"
                        Text="{tr:Tr P2SubHint}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button x:Name="menuSubAdd" Style="{StaticResource P2raySecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="13"
                                Height="13"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="Plus" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.menuSubAdd}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="menuSubEdit"
                        Margin="8,0,0,0"
                        Style="{StaticResource P2raySecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="13"
                                Height="13"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="Edit" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.menuSubEdit}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="menuSubShare"
                        Margin="8,0,0,0"
                        Style="{StaticResource P2raySecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="13"
                                Height="13"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="QrcodePlus" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.menuSubShare}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="menuSubDelete"
                        Margin="8,0,0,0"
                        Style="{StaticResource P2raySecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="13"
                                Height="13"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="Delete" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.menuSubDelete}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 订阅列表 -->
            <Border Grid.Row="1" Style="{StaticResource P2rayCard}">
                <DataGrid
                    x:Name="lstSubscription"                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    AutoGenerateColumns="False"
                    AlternatingRowBackground="Transparent"
                    Background="Transparent"
                    BorderThickness="0"
                    BorderBrush="{StaticResource P2rayDividerBrush}"
                    CanUserAddRows="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False"
                    ColumnHeaderHeight="34"
                    EnableRowVirtualization="True"
                    Foreground="{StaticResource P2rayTextPrimaryBrush}"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    RowBackground="Transparent"
                    RowHeight="38">
                    <DataGrid.ContextMenu>
                        <ContextMenu Style="{StaticResource DefContextMenu}">
                            <MenuItem
                                x:Name="menuSubAdd2"
                                Height="{StaticResource MenuItemHeight}"
                                Header="{x:Static resx:ResUI.menuSubAdd}" />
                            <MenuItem
                                x:Name="menuSubDelete2"
                                Height="{StaticResource MenuItemHeight}"
                                Header="{x:Static resx:ResUI.menuSubDelete}" />
                            <MenuItem
                                x:Name="menuSubEdit2"
                                Height="{StaticResource MenuItemHeight}"
                                Header="{x:Static resx:ResUI.menuSubEdit}" />
                            <MenuItem
                                x:Name="menuSubShare2"
                                Height="{StaticResource MenuItemHeight}"
                                Header="{x:Static resx:ResUI.menuSubShare}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource P2rayTextTertiaryBrush}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource P2rayDividerBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource P2rayHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource P2rayAccentSoftBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Remarks}"
                            Header="{x:Static resx:ResUI.LvRemarks}" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Url}"
                            Header="{x:Static resx:ResUI.LvUrl}" />
                        <DataGridCheckBoxColumn
                            Width="90"
                            Binding="{Binding Enabled}"
                            Header="{x:Static resx:ResUI.LvEnabled}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding AutoUpdateInterval}"
                            Header="{x:Static resx:ResUI.LvAutoUpdateInterval}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding UserAgent}"
                            Header="{x:Static resx:ResUI.LvUserAgent}" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Sort}"
                            Header="{x:Static resx:ResUI.LvSort}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 底部：关闭 -->
            <Button
                x:Name="menuClose"
                Grid.Row="2"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Content="{x:Static resx:ResUI.menuClose}"
                IsCancel="True"
                Style="{StaticResource P2raySecondaryButton}" />
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>
