<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.TrafficView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="760"
    d:DesignWidth="900"
    x:TypeArguments="vms:TrafficViewModel"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,24">

            <TextBlock Style="{StaticResource P2rayH1}" Text="流量" />
            <TextBlock
                Margin="0,4,0,16"
                Style="{StaticResource P2rayMicro}"
                Text="统计的是经过 P2ray 的代理流量，不含未走代理的直连流量。" />

            <!-- ═══ 概览 ═══ -->
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="今天" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource P2raySuccessBrush}"
                                Kind="ArrowUpThin" />
                            <TextBlock
                                x:Name="txtTodayUp"
                                Margin="2,0,16,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontH1}"
                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                Text="—" />
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource P2rayAccentTextBrush}"
                                Kind="ArrowDownThin" />
                            <TextBlock
                                x:Name="txtTodayDown"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontH1}"
                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                Text="—" />
                        </StackPanel>
                        <TextBlock
                            x:Name="txtPeak"
                            Margin="0,6,0,0"
                            Style="{StaticResource P2rayMicro}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="最近 7 天合计" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource P2raySuccessBrush}"
                                Kind="ArrowUpThin" />
                            <TextBlock
                                x:Name="txtWeekUp"
                                Margin="2,0,16,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontH1}"
                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                Text="—" />
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource P2rayAccentTextBrush}"
                                Kind="ArrowDownThin" />
                            <TextBlock
                                x:Name="txtWeekDown"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontH1}"
                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                Text="—" />
                        </StackPanel>
                        <Button
                            x:Name="btnClear"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Padding="10,0"
                            Click="BtnClear_Click"
                            Content="清空统计"
                            Height="22"
                            Style="{StaticResource P2raySecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 最近 24 小时 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="最近 24 小时" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel Margin="16,14">
                    <ItemsControl x:Name="lstHours">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="24" Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Bottom" ToolTip="{Binding UpText}">
                                    <!-- 柱子从下往上：下行在下、上行在上，堆叠而不是并排，
                                         并排会让每根柱子只有几像素宽，看不出比例。 -->
                                    <StackPanel
                                        Height="76"
                                        VerticalAlignment="Bottom"
                                        Orientation="Vertical">
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Border
                                                Width="10"
                                                Height="{Binding UpHeight}"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource P2raySuccessBrush}"
                                                CornerRadius="2,2,0,0" />
                                            <Border
                                                Width="10"
                                                Height="{Binding DownHeight}"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource P2rayAccentBrush}"
                                                CornerRadius="0,0,2,2" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource P2rayTextTertiaryBrush}"
                                        Text="{Binding Label}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Border
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Background="{StaticResource P2raySuccessBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            Margin="6,0,16,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource P2rayMicro}"
                            Text="上行" />
                        <Border
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Background="{StaticResource P2rayAccentBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource P2rayMicro}"
                            Text="下行" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 最近 7 天 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="最近 7 天" />
            <Border Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource P2rayMicro}"
                                Text="日期" />
                            <TextBlock
                                Grid.Column="1"
                                Width="86"
                                HorizontalAlignment="Right"
                                Style="{StaticResource P2rayMicro}"
                                Text="上行" />
                            <TextBlock
                                Grid.Column="2"
                                Width="86"
                                HorizontalAlignment="Right"
                                Style="{StaticResource P2rayMicro}"
                                Text="下行" />
                            <TextBlock
                                Grid.Column="3"
                                Width="96"
                                HorizontalAlignment="Right"
                                Style="{StaticResource P2rayMicro}"
                                Text="合计" />
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="lstDays">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource P2rayRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource P2rayBody}"
                                            Text="{Binding Label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Width="86"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas, Cascadia Mono, monospace"
                                            FontSize="{StaticResource P2rayFontCaption}"
                                            Foreground="{StaticResource P2raySuccessBrush}"
                                            Text="{Binding UpText}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Width="86"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas, Cascadia Mono, monospace"
                                            FontSize="{StaticResource P2rayFontCaption}"
                                            Foreground="{StaticResource P2rayAccentTextBrush}"
                                            Text="{Binding DownText}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Width="96"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas, Cascadia Mono, monospace"
                                            FontSize="{StaticResource P2rayFontCaption}"
                                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                            Text="{Binding TotalText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
