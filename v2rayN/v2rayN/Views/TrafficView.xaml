<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.TrafficView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="760"
    d:DesignWidth="900"
    x:TypeArguments="vms:TrafficViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,28">

            <!-- ═══ 标题 + 区间切换 ═══ -->
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource P2rayH1}" Text="流量" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource P2rayMicro}"
                        Text="统计经过 P2ray 的代理流量，不含未走代理的直连。" />
                </StackPanel>

                <!-- 区间切换放在标题右侧：它控制整页内容，属于"页面级"操作 -->
                <Border
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource P2raySegmentTrack}">
                    <ItemsControl x:Name="lstRanges">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton
                                    MinWidth="64"
                                    Checked="Range_Checked" Click="Range_Click"
                                    GroupName="P2rayTrafficRange"
                                    Style="{StaticResource P2raySegment}"
                                    Tag="{Binding}"
                                    Content="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- ═══ 区间摘要：四张数卡 ═══ -->
            <UniformGrid Margin="0,18,0,18" Columns="4">
                <Border Margin="0,0,8,0" Padding="15,13" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="区间下行" />
                        <TextBlock
                            x:Name="txtRangeDown"
                            Margin="0,7,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0" Padding="15,13" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="区间上行" />
                        <TextBlock
                            x:Name="txtRangeUp"
                            Margin="0,7,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0" Padding="15,13" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="日均下行" />
                        <TextBlock
                            x:Name="txtAverageDown"
                            Margin="0,7,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                    </StackPanel>
                </Border>
                <Border Margin="8,0,0,0" Padding="15,13" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="峰值日" />
                        <TextBlock
                            x:Name="txtPeakDay"
                            Margin="0,7,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                        <TextBlock
                            x:Name="txtPeakDown"
                            Margin="0,2,0,0"
                            Style="{StaticResource P2rayMicro}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ 折线图 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="每日趋势" />
            <Border Margin="0,0,0,18" Style="{StaticResource P2rayCard}">
                <Grid Margin="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Y 轴刻度：与网格线共用同一组绝对 y 值，避免等分容器带来的 1-2px 偏移 -->
                    <Canvas Grid.Row="0" Grid.Column="0" Height="170" ClipToBounds="False">
                        <TextBlock
                            x:Name="txtY0"
                            Canvas.Left="0"
                            Canvas.Top="-7"
                            Width="48"
                            FontSize="10"
                            TextAlignment="Right"
                            Foreground="{StaticResource P2rayTextTertiaryBrush}" />
                        <TextBlock
                            x:Name="txtY1"
                            Canvas.Left="0"
                            Canvas.Top="49"
                            Width="48"
                            FontSize="10"
                            TextAlignment="Right"
                            Foreground="{StaticResource P2rayTextTertiaryBrush}" />
                        <TextBlock
                            x:Name="txtY2"
                            Canvas.Left="0"
                            Canvas.Top="106"
                            Width="48"
                            FontSize="10"
                            TextAlignment="Right"
                            Foreground="{StaticResource P2rayTextTertiaryBrush}" />
                        <TextBlock
                            x:Name="txtY3"
                            Canvas.Left="0"
                            Canvas.Top="163"
                            Width="48"
                            FontSize="10"
                            TextAlignment="Right"
                            Foreground="{StaticResource P2rayTextTertiaryBrush}" />
                    </Canvas>

                    <!-- 绘图区 -->
                    <Viewbox
                        Grid.Row="0"
                        Grid.Column="1"
                        Height="170"
                        Stretch="Fill">
                        <Grid
                            Width="1000"
                            Height="170">
                            <!-- 水平网格线：与 Y 轴刻度同一组 y 值 -->
                            <Canvas Height="170" IsHitTestVisible="False">
                                <Border Canvas.Top="0" Width="1000" Height="1" Background="{StaticResource P2rayDividerBrush}" Opacity="0.55" />
                                <Border Canvas.Top="56" Width="1000" Height="1" Background="{StaticResource P2rayDividerBrush}" Opacity="0.35" />
                                <Border Canvas.Top="113" Width="1000" Height="1" Background="{StaticResource P2rayDividerBrush}" Opacity="0.35" />
                                <Border Canvas.Top="169" Width="1000" Height="1" Background="{StaticResource P2rayDividerBrush}" Opacity="0.55" />
                            </Canvas>

                            <!-- 下行面积：渐变到底部，避免一大块纯色显得闷 -->
                            <Path x:Name="pathDownArea" Stretch="None">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#7A3B9BFF" />
                                        <GradientStop Offset="0.55" Color="#2E3B9BFF" />
                                        <GradientStop Offset="1" Color="#003B9BFF" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <!-- 下行折线 -->
                            <Path
                                x:Name="pathDownLine"
                                Stroke="{StaticResource P2rayAccentBrush}"
                                StrokeThickness="2.4"
                                StrokeLineJoin="Round"
                                Stretch="None" />
                            <!-- 上行折线（虚线，避免和下行抢视觉） -->
                            <Path
                                x:Name="pathUpLine"
                                Stroke="{StaticResource P2raySuccessBrush}"
                                StrokeDashArray="3 3"
                                StrokeThickness="1.4"
                                Opacity="0.85"
                                Stretch="None" />

                            <!-- 数据点：点数少时才画圆，30 天时会糊成一片 -->
                            <ItemsControl x:Name="lstDots">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding DotX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding DotY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Fill="{StaticResource P2rayAccentBrush}"
                                            Visibility="{Binding IsDotVisible, Converter={StaticResource BoolToVis}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 悬停热区：每个点一块透明区域，提示框显示当日数值 -->
                            <ItemsControl x:Name="lstHotspots">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding HotX}" />
                                        <Setter Property="Canvas.Top" Value="0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle
                                            Width="{Binding HotWidth}"
                                            Height="170"
                                            ToolTip="{Binding Tooltip}">
                                            <Rectangle.Fill>
                                                <SolidColorBrush Color="White" Opacity="0.001" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="lstXAxis">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="176" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource P2rayTextTertiaryBrush}"
                                            Text="{Binding Text}">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="{Binding X}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>                    <!-- X 轴刻度：放在绘图区同一坐标系里，随 Viewbox 一起缩放 -->
                </Grid>
            </Border>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <Border
                    Width="14"
                    Height="3"
                    VerticalAlignment="Center"
                    Background="{StaticResource P2rayAccentBrush}"
                    CornerRadius="2" />
                <TextBlock
                    Margin="6,0,18,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource P2rayMicro}"
                    Text="下行" />
                <Border
                    Width="14"
                    Height="3"
                    VerticalAlignment="Center"
                    Background="{StaticResource P2raySuccessBrush}"
                    CornerRadius="2" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource P2rayMicro}"
                    Text="上行（虚线）" />
                <TextBlock
                    Margin="18,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource P2rayMicro}"
                    Text="悬停折线可查看当日用量" />
            </StackPanel>

            <!-- ═══ 明细 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="每日明细" />
            <Border Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource P2rayMicro}"
                                Text="日期" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,16,0"
                                Style="{StaticResource P2rayMicro}"
                                Text="占比" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock
                                    Width="84"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="下行" />
                                <TextBlock
                                    Width="80"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="上行" />
                                <TextBlock
                                    Width="80"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="合计" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="lstDays">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,4" Style="{StaticResource P2rayRow}">
                            <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource P2rayBody}"
                                            Text="{Binding Label}" />

                                        <Grid
                                            Grid.Column="1"
                                            Height="16"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                            <!-- 底轨：没有它时，占比很小的那一天只会剩一个小点，
                                                 看不出"占了多少"这层含义 -->
                                            <Border
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource P2rayElevatedBrush}"
                                                CornerRadius="4" />
                                            <StackPanel
                                                Height="8"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal">
                                                <Border
                                                    Width="{Binding DownBarWidth}"
                                                    Background="{StaticResource P2rayAccentBrush}"
                                                    CornerRadius="4,0,0,4" />
                                                <Border
                                                    Width="{Binding UpBarWidth}"
                                                    Background="{StaticResource P2raySuccessBrush}"
                                                    CornerRadius="0,4,4,0" />
                                            </StackPanel>
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource P2rayTextTertiaryBrush}"
                                                Text="{Binding ShareText}" />
                                        </Grid>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock
                                                Width="84"
                                                HorizontalAlignment="Right"
                                                FontFamily="Consolas, Cascadia Mono, monospace"
                                                FontSize="{StaticResource P2rayFontCaption}"
                                                Foreground="{StaticResource P2rayAccentTextBrush}"
                                                Text="{Binding DownText}" />
                                            <TextBlock
                                                Width="80"
                                                HorizontalAlignment="Right"
                                                FontFamily="Consolas, Cascadia Mono, monospace"
                                                FontSize="{StaticResource P2rayFontCaption}"
                                                Foreground="{StaticResource P2raySuccessBrush}"
                                                Text="{Binding UpText}" />
                                            <TextBlock
                                                Width="80"
                                                HorizontalAlignment="Right"
                                                FontFamily="Consolas, Cascadia Mono, monospace"
                                                FontSize="{StaticResource P2rayFontCaption}"
                                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                                Text="{Binding TotalText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Button
                x:Name="btnClear"
                Margin="2,14,0,0"
                HorizontalAlignment="Left"
                Padding="12,0"
                Click="BtnClear_Click"
                Content="清空统计"
                Height="26"
                Style="{StaticResource P2raySecondaryButton}" />
        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
