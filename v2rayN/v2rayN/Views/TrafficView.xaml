<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.TrafficView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="760"
    d:DesignWidth="900"
    x:TypeArguments="vms:TrafficViewModel"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,28">

            <!-- ═══ 标题 ═══ -->
            <TextBlock Style="{StaticResource P2rayH1}" Text="流量" />
            <TextBlock
                Margin="0,4,0,18"
                Style="{StaticResource P2rayMicro}"
                Text="统计经过 P2ray 的代理流量，不含未走代理的直连。" />

            <!-- ═══ 三张数卡：数值单独成卡，比挤在一行里更好读 ═══ -->
            <UniformGrid Margin="0,0,0,18" Columns="3">
                <Border
                    Margin="0,0,10,0"
                    Padding="16,14"
                    Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="今天" />
                        <TextBlock
                            x:Name="txtTodayDown"
                            Margin="0,8,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource P2raySuccessBrush}"
                                Kind="ArrowUpThin" />
                            <TextBlock
                                x:Name="txtTodayUp"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Margin="5,0,5,0"
                    Padding="16,14"
                    Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="最近 7 天下行" />
                        <TextBlock
                            x:Name="txtWeekDown"
                            Margin="0,8,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource P2raySuccessBrush}"
                                Kind="ArrowUpThin" />
                            <TextBlock
                                x:Name="txtWeekUp"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Margin="10,0,0,0"
                    Padding="16,14"
                    Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="峰值时段" />
                        <TextBlock
                            x:Name="txtPeak"
                            Margin="0,8,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                        <TextBlock
                            x:Name="txtPeakHint"
                            Margin="0,4,0,0"
                            Style="{StaticResource P2rayMicro}"
                            Text="最近 24 小时" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ 最近 24 小时 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="最近 24 小时" />
            <Border Margin="0,0,0,18" Style="{StaticResource P2rayCard}">
                <StackPanel Margin="18,16,18,12">
                    <!-- 基线 + 柱子：柱子贴底、间距均匀，横轴每 3 小时一个刻度 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ItemsControl x:Name="lstHours" Height="140">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="24" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding Tooltip}">
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Border
                                                Width="14"
                                                Height="{Binding UpHeight}"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource P2raySuccessBrush}"
                                                CornerRadius="2,2,0,0" />
                                            <Border
                                                Width="14"
                                                Height="{Binding DownHeight}"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource P2rayAccentBrush}"
                                                CornerRadius="0,0,2,2" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 基线 -->
                        <Border
                            Grid.Row="1"
                            Height="1"
                            Background="{StaticResource P2rayDividerBrush}" />
                        <UniformGrid Grid.Row="1" Margin="0,6,0,0" Columns="8">
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource P2rayTextTertiaryBrush}" Text="00" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource P2rayTextTertiaryBrush}" Text="03" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource P2rayTextTertiaryBrush}" Text="06" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource P2rayTextTertiaryBrush}" Text="09" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource P2rayTextTertiaryBrush}" Text="12" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource P2rayTextTertiaryBrush}" Text="15" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource P2rayTextTertiaryBrush}" Text="18" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource P2rayTextTertiaryBrush}" Text="21" />
                        </UniformGrid>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Border
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Background="{StaticResource P2rayAccentBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            Margin="6,0,16,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource P2rayMicro}"
                            Text="下行" />
                        <Border
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Background="{StaticResource P2raySuccessBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource P2rayMicro}"
                            Text="上行" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 最近 7 天 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="最近 7 天" />
            <Border Style="{StaticResource P2rayCard}">
                <ItemsControl x:Name="lstDays">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource P2rayRow}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource P2rayBody}"
                                        Text="{Binding Label}" />

                                    <!-- 比例条：下行在下、上行叠在右侧，长度按窗口内最大值归一 -->
                                    <Grid
                                        Grid.Column="1"
                                        Height="10"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                        <Border
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource P2raySurfaceBrush}"
                                            CornerRadius="5" />
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                            <Border
                                                Width="{Binding DownBarWidth}"
                                                Height="10"
                                                Background="{StaticResource P2rayAccentBrush}"
                                                CornerRadius="5,0,0,5" />
                                            <Border
                                                Width="{Binding UpBarWidth}"
                                                Height="10"
                                                Background="{StaticResource P2raySuccessBrush}"
                                                CornerRadius="0,5,5,0" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="80"
                                            HorizontalAlignment="Right"
                                            FontFamily="Consolas, Cascadia Mono, monospace"
                                            FontSize="{StaticResource P2rayFontCaption}"
                                            Foreground="{StaticResource P2rayAccentTextBrush}"
                                            Text="{Binding DownText}" />
                                        <TextBlock
                                            Width="70"
                                            HorizontalAlignment="Right"
                                            FontFamily="Consolas, Cascadia Mono, monospace"
                                            FontSize="{StaticResource P2rayFontCaption}"
                                            Foreground="{StaticResource P2rayTextTertiaryBrush}"
                                            Text="{Binding UpText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Button
                x:Name="btnClear"
                Margin="2,14,0,0"
                HorizontalAlignment="Left"
                Padding="12,0"
                Click="BtnClear_Click"
                Content="清空统计"
                Height="26"
                Style="{StaticResource P2raySecondaryButton}" />
        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
