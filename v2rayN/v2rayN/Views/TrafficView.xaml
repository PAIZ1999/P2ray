<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.TrafficView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:v2rayN.Controls"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tr="clr-namespace:v2rayN.Markup"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="760"
    d:DesignWidth="900"
    x:TypeArguments="vms:TrafficViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,28">

            <!-- ═══ 标题 + 区间切换 ═══ -->
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource P2rayH1}" Text="{tr:Tr P2TrafficTitle}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource P2rayMicro}"
                        Text="{tr:Tr P2TrafficSubtitle}" />
                </StackPanel>

                <StackPanel
                    Margin="0,6,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">

                <!-- 子标签：概览（按天） / 按域名 -->
                <Border Margin="0,0,10,0" Style="{StaticResource P2raySegmentTrack}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            x:Name="tabSummary"
                            MinWidth="64"
                            Checked="Tab_Checked"
                            Content="{tr:Tr P2TrafficOverview}"
                            GroupName="P2rayTrafficTab"
                            IsChecked="True"
                            Style="{StaticResource P2raySegment}"
                            Tag="summary" />
                        <RadioButton
                            x:Name="tabDomain"
                            MinWidth="64"
                            Checked="Tab_Checked"
                            Content="{tr:Tr P2TrafficByDomain}"
                            GroupName="P2rayTrafficTab"
                            Style="{StaticResource P2raySegment}"
                            Tag="domain" />
                        <RadioButton
                            x:Name="tabApp"
                            MinWidth="64"
                            Checked="Tab_Checked"
                            Content="{tr:Tr P2TrafficByApp}"
                            GroupName="P2rayTrafficTab"
                            Style="{StaticResource P2raySegment}"
                            Tag="app" />
                    </StackPanel>
                </Border>

                                <!-- 区间切换放在标题右侧：它控制整页内容，属于"页面级"操作 -->
                <Border Style="{StaticResource P2raySegmentTrack}">
                    <ItemsControl x:Name="lstRanges">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton
                                    MinWidth="64"
                                    Checked="Range_Checked" Click="Range_Click"
                                    GroupName="P2rayTrafficRange"
                                    Style="{StaticResource P2raySegment}"
                                    Tag="{Binding}"
                                    Content="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="summaryPanel">
            <!-- ═══ 区间摘要：四张数卡 ═══ -->
            <UniformGrid Margin="0,18,0,18" Columns="4">
                <Border Margin="0,0,8,0" Padding="15,13" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="{tr:Tr P2TrafficRangeDown}" />
                        <TextBlock
                            x:Name="txtRangeDown"
                            Margin="0,7,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0" Padding="15,13" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="{tr:Tr P2TrafficRangeUp}" />
                        <TextBlock
                            x:Name="txtRangeUp"
                            Margin="0,7,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0" Padding="15,13" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="{tr:Tr P2TrafficDailyAvg}" />
                        <TextBlock
                            x:Name="txtAverageDown"
                            Margin="0,7,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                    </StackPanel>
                </Border>
                <Border Margin="8,0,0,0" Padding="15,13" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P2rayMicro}" Text="{tr:Tr P2TrafficPeakDay}" />
                        <TextBlock
                            x:Name="txtPeakDay"
                            Margin="0,7,0,0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                            Text="—" />
                        <TextBlock
                            x:Name="txtPeakDown"
                            Margin="0,2,0,0"
                            Style="{StaticResource P2rayMicro}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ 折线图（自绘：网格 + 面积 + 折线 + 十字准线 + 跟随卡片） ═══ -->
            <Border Margin="0,0,0,18" Style="{StaticResource P2rayCard}">
                <Grid Margin="18,16,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题行：左侧说明，右侧图例 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource P2rayMicro}"
                            Text="{tr:Tr P2TrafficTrend}" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Border
                                Width="12"
                                Height="3"
                                VerticalAlignment="Center"
                                Background="{StaticResource P2rayAccentBrush}"
                                CornerRadius="2" />
                            <TextBlock
                                Margin="6,0,14,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}"
                                Text="{tr:Tr P2TrafficDown}" />
                            <Border
                                Width="12"
                                Height="3"
                                VerticalAlignment="Center"
                                Background="{StaticResource P2raySuccessBrush}"
                                CornerRadius="2" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}"
                                Text="{tr:Tr P2TrafficUp}" />
                        </StackPanel>
                    </Grid>

                    <!-- 绘图区：Canvas 由代码绘制，命中测试也在代码里做 -->
                    <Grid Grid.Row="1" Height="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Y 轴刻度：右侧对齐到网格线 -->
                        <Canvas x:Name="yAxisLayer" Grid.Column="0" Height="200" />

                        <Grid
                            x:Name="plotHost"
                            Grid.Column="1"
                            Background="Transparent"
                            ClipToBounds="True"
                            MouseLeave="Plot_MouseLeave"
                            MouseMove="Plot_MouseMove"
                            SizeChanged="Plot_SizeChanged">
                            <Canvas x:Name="plotLayer" />
                        </Grid>
                    </Grid>

                    <!-- X 轴刻度 -->
                    <Canvas
                        x:Name="xAxisLayer"
                        Grid.Row="2"
                        Height="18"
                        Margin="62,6,0,0" />

                    <!-- 空数据提示 -->
                    <controls:EmptyStateView
                        x:Name="txtChartEmpty"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Hint="{tr:Tr P2TrafficEmptyHint}"
                        Icon="ChartTimelineVariant"
                        Title="{tr:Tr P2TrafficEmptyRange}"
                        Visibility="Collapsed" />

                    <!-- 悬停卡片：随鼠标水平位置滑动，垂直方向固定顶部，避免抖动 -->
                    <Border
                        x:Name="hoverCard"
                        Grid.Row="1"
                        Padding="10,7"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource P2rayElevatedBrush}"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                x:Name="txtHoverDate"
                                FontSize="10"
                                Foreground="{StaticResource P2rayTextTertiaryBrush}" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource P2rayAccentBrush}" />
                                <TextBlock
                                    x:Name="txtHoverDown"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                    FontSize="11"
                                    Foreground="{StaticResource P2rayTextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource P2raySuccessBrush}" />
                                <TextBlock
                                    x:Name="txtHoverUp"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                    FontSize="11"
                                    Foreground="{StaticResource P2rayTextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            

            <!-- ═══ 明细 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="{tr:Tr P2TrafficDetail}" />
            <Border Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource P2rayMicro}"
                                Text="{tr:Tr P2TrafficDate}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,16,0"
                                Style="{StaticResource P2rayMicro}"
                                Text="{tr:Tr P2TrafficShare}" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <TextBlock
                                    Width="84"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2TrafficDown}" />
                                <TextBlock
                                    Width="80"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2TrafficUp}" />
                                <TextBlock
                                    Width="80"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2TrafficTotal}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="lstDays">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,4" Style="{StaticResource P2rayRow}">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource P2rayBody}"
                                            Text="{Binding Label}" />

                                        <Grid
                                            Grid.Column="1"
                                            Height="16"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                            <!-- 底轨：没有它时，占比很小的那一天只会剩一个小点，
                                                 看不出"占了多少"这层含义 -->
                                            <Border
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource P2rayElevatedBrush}"
                                                CornerRadius="4" />
                                            <StackPanel
                                                Height="8"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal">
                                                <Border
                                                    Width="{Binding DownBarWidth}"
                                                    Background="{StaticResource P2rayAccentBrush}"
                                                    CornerRadius="4,0,0,4" />
                                                <Border
                                                    Width="{Binding UpBarWidth}"
                                                    Background="{StaticResource P2raySuccessBrush}"
                                                    CornerRadius="0,4,4,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 百分比单独一列：压在进度条上会和条长互相干扰，
                                             条接近满格时更是直接盖住 -->

                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <TextBlock
                                                Width="84"
                                                HorizontalAlignment="Right"
                                                FontFamily="Consolas, Cascadia Mono, monospace"
                                                FontSize="{StaticResource P2rayFontCaption}"
                                                Foreground="{StaticResource P2rayAccentTextBrush}"
                                                Text="{Binding DownText}" />
                                            <TextBlock
                                                Width="80"
                                                HorizontalAlignment="Right"
                                                FontFamily="Consolas, Cascadia Mono, monospace"
                                                FontSize="{StaticResource P2rayFontCaption}"
                                                Foreground="{StaticResource P2raySuccessBrush}"
                                                Text="{Binding UpText}" />
                                            <TextBlock
                                                Width="80"
                                                HorizontalAlignment="Right"
                                                FontFamily="Consolas, Cascadia Mono, monospace"
                                                FontSize="{StaticResource P2rayFontCaption}"
                                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                                Text="{Binding TotalText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- ═══ 按域名（依赖 clash API） ═══ -->
            <StackPanel x:Name="domainPanel" Visibility="Collapsed">
                <TextBlock
                    Margin="0,18,0,10"
                    Style="{StaticResource P2rayMicro}"
                    Text="{tr:Tr P2TrafficDomainHint}" />

                <Border Padding="14,12" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}"
                                Text="{tr:Tr P2TrafficDomainTotal}" />
                            <TextBlock
                                x:Name="txtDomainTotal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontH2}"
                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                Text="—" />
                        </Grid>

                        <!-- 不支持时只显示原因，不显示空列表 -->
                        <TextBlock
                            x:Name="txtDomainHint"
                            Margin="0,4,0,0"
                            Style="{StaticResource P2rayMicro}"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource P2rayWarningBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <Border Style="{StaticResource P2rayRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2TrafficDomain}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2TrafficShare}" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBlock
                                        Width="90"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource P2rayMicro}"
                                        Text="{tr:Tr P2TrafficDown}" />
                                    <TextBlock
                                        Width="80"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource P2rayMicro}"
                                        Text="{tr:Tr P2TrafficUp}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="lstDomains">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,4" Style="{StaticResource P2rayRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource P2rayBody}"
                                                Text="{Binding Host}"
                                                TextTrimming="CharacterEllipsis" />

                                            <Grid
                                                Grid.Column="1"
                                                Height="16"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource P2rayElevatedBrush}"
                                                    CornerRadius="4" />
                                                <StackPanel
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Orientation="Horizontal">
                                                    <Border
                                                        Width="{Binding DownBarWidth}"
                                                        Background="{StaticResource P2rayAccentBrush}"
                                                        CornerRadius="4,0,0,4" />
                                                    <Border
                                                        Width="{Binding UpBarWidth}"
                                                        Background="{StaticResource P2raySuccessBrush}"
                                                        CornerRadius="0,4,4,0" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="90"
                                                    HorizontalAlignment="Right"
                                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                                    FontSize="{StaticResource P2rayFontCaption}"
                                                    Foreground="{StaticResource P2rayAccentTextBrush}"
                                                    Text="{Binding DownText}" />
                                                <TextBlock
                                                    Width="80"
                                                    HorizontalAlignment="Right"
                                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                                    FontSize="{StaticResource P2rayFontCaption}"
                                                    Foreground="{StaticResource P2raySuccessBrush}"
                                                    Text="{Binding UpText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ 按应用（ETW，需管理员） ═══ -->
            <StackPanel x:Name="appPanel" Visibility="Collapsed">
                <Grid Margin="0,18,0,10">
                    <TextBlock
                        x:Name="txtAppScope"
                        MaxWidth="900"
                        HorizontalAlignment="Left"
                        Style="{StaticResource P2rayMicro}"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource P2rayWarningBrush}" />
                    <ToggleButton
                        x:Name="togAppProxyOnly"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="16,0,0,0"
                        Width="44"
                        Height="20"
                        Click="TogAppProxyOnly_Click"
                        Style="{StaticResource P2rayToggle}"
                        ToolTip="仅统计经本地代理端口的流量" />
                </Grid>

                <Border Padding="14,12" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}"
                                x:Name="txtAppTotalLabel"
                                Text="{tr:Tr P2TrafficAppTotal}" />
                            <TextBlock
                                x:Name="txtAppTotal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontH2}"
                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                Text="—" />
                        </Grid>
                        <TextBlock
                            x:Name="txtAppHint"
                            Margin="0,4,0,0"
                            Style="{StaticResource P2rayMicro}"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource P2rayWarningBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource P2rayCard}">
                    <StackPanel>
                        <Border Style="{StaticResource P2rayRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2TrafficProcess}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2TrafficShare}" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBlock
                                        Width="90"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource P2rayMicro}"
                                        Text="{tr:Tr P2TrafficDown}" />
                                    <TextBlock
                                        Width="80"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource P2rayMicro}"
                                        Text="{tr:Tr P2TrafficUp}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="lstApps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,4" Style="{StaticResource P2rayRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource P2rayBody}"
                                                Text="{Binding Host}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Grid
                                                Grid.Column="1"
                                                Height="16"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource P2rayElevatedBrush}"
                                                    CornerRadius="4" />
                                                <StackPanel
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Orientation="Horizontal">
                                                    <Border
                                                        Width="{Binding DownBarWidth}"
                                                        Background="{StaticResource P2rayAccentBrush}"
                                                        CornerRadius="4,0,0,4" />
                                                    <Border
                                                        Width="{Binding UpBarWidth}"
                                                        Background="{StaticResource P2raySuccessBrush}"
                                                        CornerRadius="0,4,4,0" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="90"
                                                    HorizontalAlignment="Right"
                                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                                    FontSize="{StaticResource P2rayFontCaption}"
                                                    Foreground="{StaticResource P2rayAccentTextBrush}"
                                                    Text="{Binding DownText}" />
                                                <TextBlock
                                                    Width="80"
                                                    HorizontalAlignment="Right"
                                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                                    FontSize="{StaticResource P2rayFontCaption}"
                                                    Foreground="{StaticResource P2raySuccessBrush}"
                                                    Text="{Binding UpText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button
                x:Name="btnClear"
                Margin="2,14,0,0"
                HorizontalAlignment="Left"
                Padding="12,0"
                Click="BtnClear_Click"
                Content="{tr:Tr P2TrafficClear}"
                Height="26"
                Style="{StaticResource P2raySecondaryButton}" />
        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
