<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.NodesView"
    x:TypeArguments="vms:DashboardViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:v2rayN.Controls"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 延迟着色：必须在本视图内定义。ProfilesView 里的同名资源是局部作用域，跨视图不可见。 -->
        <conv:DelayColorConverter x:Key="DelayColorConverter" />

        <!-- 节点行：选中态左侧高亮 -->
        <Style x:Key="NodeRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border
                            x:Name="Bg"
                            Padding="14,11"
                            Background="Transparent"
                            BorderBrush="{StaticResource P2rayDividerBrush}"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayAccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="{StaticResource P2rayPagePadding}">

        <!-- ===== 顶部操作栏 ===== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource P2rayH1}" Text="节点" />
                <TextBlock
                    x:Name="txtCount"
                    Margin="0,3,0,0"
                    Style="{StaticResource P2rayCaption}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Click="BtnRefresh_Click"
                    Content="刷新"
                    Style="{StaticResource P2raySecondaryButton}" />
                <Button
                    Margin="0,0,8,0"
                    Click="BtnCustomConfig_Click"
                    Content="自定义配置"
                    Style="{StaticResource P2raySecondaryButton}" />
                <Button
                    Margin="8,0,0,0"
                    Click="BtnImport_Click"
                    Content="从剪贴板导入"
                    Style="{StaticResource P2rayPrimaryButton}" />
            </StackPanel>
        </Grid>

        <!-- ===== 分组切换 =====
             横向排列而非下拉框：分组通常只有几个，摊开一眼可见，少一次点击。
             首项「所有」由 ViewModel 追加（Id 为空，代表不按订阅过滤）。 -->
        <ScrollViewer
            Margin="0,0,0,12"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            DockPanel.Dock="Top">
            <ItemsControl x:Name="lstGroups">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton
                            Margin="0,0,8,0"
                            Checked="Group_Checked"
                            Content="{Binding Remarks}"
                            GroupName="NodeGroup"
                            Style="{StaticResource P2rayGroupChip}"
                            Tag="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== 节点列表 ===== -->
        <Border
            Padding="0"
            Style="{StaticResource P2rayCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border
                    Padding="14,10"
                    Background="{StaticResource P2rayBgBrush}"
                    BorderBrush="{StaticResource P2rayDividerBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource P2rayMicro}"
                            Text="节点" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource P2rayMicro}"
                            Text="协议" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource P2rayMicro}"
                            Text="延迟" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource P2rayMicro}"
                            Text="今日 ↑ / ↓" />
                        <TextBlock
                            Grid.Column="4"
                            Style="{StaticResource P2rayMicro}"
                            Text="累计 ↑ / ↓" />
                    </Grid>
                </Border>

                <ListBox
                    x:Name="lstNodes"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource NodeRow}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionMode="Extended">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="MenuSetDefault_Click" Header="设为默认" />
                            <MenuItem Click="MenuTestDelay_Click" Header="测试延迟" />
                            <MenuItem Click="MenuEdit_Click" Header="编辑" />
                            <Separator />
                            <MenuItem Click="MenuDelete_Click" Header="删除" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="124" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 默认节点标记：与"列表选中"区分开，避免两个高亮造成歧义 -->
                                        <Border
                                            x:Name="badgeDefault"
                                            Margin="0,0,6,0"
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource P2rayAccentSoftBrush}"
                                            CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource P2rayAccentTextBrush}"
                                                Text="默认" />
                                        </Border>
                                        <TextBlock
                                            Style="{StaticResource P2rayBody}"
                                            Text="{Binding Remarks}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource P2rayMicro}"
                                        Text="{Binding Address}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource P2rayCaption}"
                                    Text="{Binding ConfigType}" />

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Delay, Converter={StaticResource DelayColorConverter}}"
                                    Style="{StaticResource P2rayCaption}"
                                    Text="{Binding DelayVal}" />

                                <!-- 流量：数据来自 ServerStatItem，由统计服务定时写入。
                                     未产生过流量时显示破折号，而不是留一格空白 ——
                                     空白看不出是"没有流量"还是"这功能没实现"。 -->
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource P2rayCaption}"
                                    Text="{Binding TodayTrafficText}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource P2rayCaption}"
                                    Text="{Binding TotalTrafficText}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <controls:EmptyStateView
                    x:Name="txtEmpty"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Hint="从剪贴板导入分享链接，或在首页更新订阅"
                    Icon="ServerNetworkOutline"
                    Title="还没有节点" />
            </Grid>
        </Border>
    </DockPanel>
</reactiveui:ReactiveUserControl>
