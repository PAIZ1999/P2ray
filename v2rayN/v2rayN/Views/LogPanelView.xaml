<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.LogPanelView"
    x:TypeArguments="vms:MsgViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="240"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <DockPanel>
        <!-- 极简工具条：仅保留清空与自动滚动 -->
        <StackPanel
            Margin="0,0,0,8"
            HorizontalAlignment="Right"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <ToggleButton
                x:Name="togAutoScroll"
                VerticalAlignment="Center"
                Content="自动滚动"
                FontSize="{StaticResource P2rayFontMicro}"
                IsChecked="True"
                Style="{StaticResource P2rayLogToggle}" />
            <Button
                x:Name="btnCopy"
                Margin="8,0,0,0"
                Padding="10,0"
                Click="BtnCopy_Click"
                Content="复制"
                Height="26"
                Style="{StaticResource P2raySecondaryButton}" />
            <Button
                x:Name="btnClear"
                Margin="6,0,0,0"
                Padding="10,0"
                Click="BtnClear_Click"
                Content="清空"
                Height="26"
                Style="{StaticResource P2raySecondaryButton}" />
        </StackPanel>

        <Border
            Background="{StaticResource P2rayBgBrush}"
            BorderBrush="{StaticResource P2rayBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource P2rayRadiusS}">
            <!-- 日志区必须有固定高度上限。
                 TextBox 默认按内容撑高，展开日志后窗口会被拉到几千像素，
                 外层 ScrollViewer 里的滚动条随之失效 —— 用户只能靠拖窗口才能看全。
                 MaxHeight + 内部滚动条让日志在自己的框里滚，页面高度不变。 -->
            <TextBox
                x:Name="txtLog"
                MinHeight="120"
                MaxHeight="300"
                Padding="10,8"
                AcceptsReturn="True"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Consolas, Cascadia Mono, monospace"
                FontSize="{StaticResource P2rayFontMicro}"
                Foreground="{StaticResource P2rayTextSecondaryBrush}"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="True"
                IsUndoEnabled="False"
                TextWrapping="NoWrap"
                UndoLimit="0"
                VerticalScrollBarVisibility="Auto" />
        </Border>
    </DockPanel>
</reactiveui:ReactiveUserControl>
