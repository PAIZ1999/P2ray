<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.DashboardView"
    x:TypeArguments="vms:DashboardViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:ctrl="clr-namespace:v2rayN.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="820"
    d:DesignWidth="1060"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,20">

            <!-- ═══ 连接状态：macOS 顶部主卡 ═══ -->
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                x:Name="ellStatus"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource P2rayIdleBrush}" />
                            <TextBlock
                                x:Name="txtStatus"
                                Style="{StaticResource P2rayMicro}"
                                FontWeight="SemiBold" />
                        </StackPanel>

                        <TextBlock
                            x:Name="txtCurrentServer"
                            Margin="0,8,0,0"
                            Style="{StaticResource P2rayDisplay}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            x:Name="txtHint"
                            Margin="0,4,0,0"
                            Style="{StaticResource P2rayCaption}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="btnConnect"
                            Click="BtnConnect_Click"
                            Content="连接"
                            Style="{StaticResource P2rayConnectButton}" />
                        <Button
                            x:Name="btnDisconnect"
                            Click="BtnDisconnect_Click"
                            Content="断开"
                            Style="{StaticResource P2rayDisconnectButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 分组：连接方式 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="连接方式" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 系统代理 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconBlue}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Web" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="系统代理" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="浏览器等程序自动走代理，最省事" />
                            </StackPanel>

                            <ToggleButton
                                x:Name="togSystemProxy"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TogSystemProxy_Click"
                                Style="{StaticResource P2rayToggle}" />
                        </Grid>
                    </Border>

                    <!-- TUN -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconPurple}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ShieldLockOutline" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="TUN 模式" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="接管电脑上全部流量，游戏与命令行也生效" />
                            </StackPanel>

                            <ToggleButton
                                x:Name="togTun"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TogTun_Click"
                                Style="{StaticResource P2rayToggle}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 分组：流量 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="流量" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 行：下载 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGreen}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ArrowDownThin" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="下载" />

                            <ctrl:Sparkline
                                x:Name="chartDownload"
                                Grid.Column="2"
                                Height="24"
                                Margin="20,0"
                                VerticalAlignment="Center"
                                Fill="#2230D158"
                                Stroke="{StaticResource P2raySuccessBrush}"
                                Values="{Binding DownloadHistory}" />

                            <TextBlock
                                x:Name="txtDownload"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayH2}"
                                Text="0 B/s" />
                        </Grid>
                    </Border>

                    <!-- 行：上传 -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconBlue}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ArrowUpThin" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="上传" />

                            <TextBlock
                                x:Name="txtUpload"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayH2}"
                                Text="0 B/s" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 分组：订阅 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="订阅" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 订阅列表 -->
                    <ItemsControl x:Name="lstSubscriptions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource P2rayRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Background="{StaticResource P2rayIconPurple}"
                                            Style="{StaticResource P2rayRowIcon}">
                                            <materialDesign:PackIcon
                                                Width="13"
                                                Height="13"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Kind="CloudDownloadOutline" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource P2rayBody}"
                                            Text="{Binding Remarks}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource P2rayMicro}"
                                            Text="{Binding UpdateTime, Converter={x:Static conv:UnixTimeConverter.Instance}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 无订阅时的引导行 -->
                    <StackPanel x:Name="guidePanel">
                        <Border Style="{StaticResource P2rayRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{StaticResource P2rayIconPurple}"
                                    Style="{StaticResource P2rayRowIcon}">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="CloudDownloadOutline" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource P2rayBody}" Text="还没有订阅" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource P2rayMicro}"
                                        Text="从服务商复制一条订阅链接" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="BtnAddSub_Click"
                                    Content="添加"
                                    Style="{StaticResource P2rayPrimaryButton}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 更新全部 -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconBlue}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Refresh" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="更新全部订阅" />

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnUpdateSub_Click"
                                Content="更新"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 分组：线路与运行 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="线路与运行" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 可用线路 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconOrange}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ServerNetwork" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="可用线路" />

                            <TextBlock
                                x:Name="txtNodeCount"
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayCaption}"
                                Text="0 条" />

                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Click="BtnGoNodes_Click"
                                Content="更换"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>

                    <!-- 能否上网 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconTeal}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Earth" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="网络状态" />

                            <TextBlock
                                x:Name="txtInternet"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayCaption}" />
                        </Grid>
                    </Border>

                    <!-- 已连接时长 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGray}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ClockOutline" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="已连接时长" />

                            <TextBlock
                                x:Name="txtRunTime"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayCaption}"
                                Text="—" />
                        </Grid>
                    </Border>

                    <!-- 运行核心 -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGray}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Chip" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="运行核心" />

                            <TextBlock
                                x:Name="txtCoreType"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayCaption}"
                                Text="—" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 分组：本地端口（放到最下方，属于排查信息） ═══ -->
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <Border Style="{StaticResource P2rayRowLast}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="{StaticResource P2rayIconGray}"
                            Style="{StaticResource P2rayRowIcon}">
                            <materialDesign:PackIcon
                                Width="13"
                                Height="13"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="LanConnect" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource P2rayBody}" Text="本地端口" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource P2rayMicro}"
                                Text="其他软件要手动填代理时用这个端口" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="txtLocalPort"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontBody}"
                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                Text="—" />
                            <Button
                                Margin="8,0,0,0"
                                Padding="10,0"
                                Click="BtnCopyPort_Click"
                                Content="复制"
                                Height="24"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ═══ 运行日志（折叠） ═══ -->
            <Button
                x:Name="btnToggleLog"
                HorizontalAlignment="Left"
                Margin="4,0,0,0"
                Click="BtnToggleLog_Click"
                Content="显示运行日志"
                Style="{StaticResource P2raySecondaryButton}" />

            <Border
                x:Name="logCard"
                Margin="0,10,0,0"
                Style="{StaticResource P2rayCard}"
                Visibility="Collapsed">
                <ContentControl x:Name="msgHost" Margin="12" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
