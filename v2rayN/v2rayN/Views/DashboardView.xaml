<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.DashboardView"
    x:TypeArguments="vms:DashboardViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:ctrl="clr-namespace:v2rayN.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="820"
    d:DesignWidth="1060"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,20">

            <!-- ═══ 连接状态：macOS 顶部主卡 ═══ -->
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                x:Name="ellStatus"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource P2rayIdleBrush}" />
                            <TextBlock
                                x:Name="txtStatus"
                                Style="{StaticResource P2rayMicro}"
                                FontWeight="SemiBold" />
                        </StackPanel>

                        <TextBlock
                            x:Name="txtCurrentServer"
                            Margin="0,8,0,0"
                            Style="{StaticResource P2rayDisplay}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            x:Name="txtHint"
                            Margin="0,4,0,0"
                            Style="{StaticResource P2rayCaption}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="btnConnect"
                            Click="BtnConnect_Click"
                            Content="连接"
                            Style="{StaticResource P2rayConnectButton}" />
                        <Button
                            x:Name="btnDisconnect"
                            Click="BtnDisconnect_Click"
                            Content="断开"
                            Style="{StaticResource P2rayDisconnectButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 分组：连接方式 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="连接方式" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 系统代理 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconBlue}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Web" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="系统代理" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="浏览器等程序自动走代理，最省事" />
                            </StackPanel>

                            <ToggleButton
                                x:Name="togSystemProxy"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TogSystemProxy_Click"
                                Style="{StaticResource P2rayToggle}" />
                        </Grid>
                    </Border>

                    <!-- TUN -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconPurple}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ShieldLockOutline" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="TUN 模式" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="接管电脑上全部流量，游戏与命令行也生效" />
                            </StackPanel>

                            <ToggleButton
                                x:Name="togTun"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TogTun_Click"
                                Style="{StaticResource P2rayToggle}" />
                        </Grid>
                    </Border>
                    <!-- 路由模式：分段按钮，三种内置模式各一个 -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 这一行会展开自定义直连面板，高度随内容变化。
                                 图标必须钉在顶部：保持默认的垂直居中，面板一展开
                                 图标就会滑到整块内容的中间，看着像"乱跑"。 -->
                            <Border
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Background="{StaticResource P2rayIconOrange}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ArrowSplitVertical" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="代理模式" />

                                <!-- 一条轨道里均分三段：宽度固定，选中段才不会被文字长度带偏 -->
                                <Border
                                    Width="300"
                                    Margin="0,9,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource P2raySegmentTrack}">
                                    <ItemsControl x:Name="lstRoutingModes">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton
                                                    Checked="RoutingMode_Checked"
                                                    GroupName="P2rayRoutingMode"
                                                    Style="{StaticResource P2raySegment}"
                                                    Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="13"
                                                            Height="13"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Kind="{Binding Remarks, Converter={x:Static conv:RoutingKindConverter.Instance}}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Remarks, Converter={x:Static conv:RoutingNameConverter.Instance}}" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock
                                    x:Name="txtRoutingHint"
                                    Margin="1,8,0,0"
                                    Style="{StaticResource P2rayCaption}"
                                    TextWrapping="Wrap" />

                                <!-- 自定义直连：给用户一个"这个网站别走代理"的入口。
                                     上游的路由设置界面列的是整张规则表（outboundTag / geosite / geoip），
                                     对只想让某个站直连的人来说全是噪音，所以这里只收一个域名或 IP。 -->
                                <Grid Margin="0,10,0,0">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource P2rayCaption}"
                                        Text="自定义直连" />
                                    <Button
                                        x:Name="btnToggleDirectRule"
                                        HorizontalAlignment="Right"
                                        Padding="10,0"
                                        Height="24"
                                        Click="BtnToggleDirectRule_Click"
                                        Content="配置"
                                        Style="{StaticResource P2raySecondaryButton}" />
                                </Grid>

                                <StackPanel
                                    x:Name="directRulePanel"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 输入框与按钮同一行，符合"填一个、加一个"的心智。
                                             文本不走 Binding：这张卡片不是通过 DataContext 拿 ViewModel 的，
                                             Binding 在 ReactiveUserControl 的泛型基类上不保证能解析到，
                                             点"添加"时会读到空值。改为按钮点击时直接读 TextBox.Text。 -->
                                        <TextBox
                                            x:Name="txtDirectRuleInput"
                                            Grid.Column="0"
                                            Height="30"
                                            Padding="10,0"
                                            VerticalContentAlignment="Center"
                                            Background="{StaticResource P2raySurfaceBrush}"
                                            BorderBrush="{StaticResource P2rayBorderBrush}"
                                            BorderThickness="1"
                                            CaretBrush="{StaticResource P2rayTextPrimaryBrush}"
                                            FontSize="{StaticResource P2rayFontCaption}"
                                            Foreground="{StaticResource P2rayTextPrimaryBrush}" />
                                        <Button
                                            Grid.Column="1"
                                            Width="64"
                                            Height="30"
                                            Margin="8,0,0,0"
                                            Click="BtnAddDirectRule_Click"
                                            Content="添加"
                                            Style="{StaticResource P2rayPrimaryButton}" />
                                    </Grid>

                                    <TextBlock
                                        Margin="1,6,0,0"
                                        Style="{StaticResource P2rayMicro}"
                                        Text="填域名或 IP，例如 openai.com 或 192.168.1.10。加进去的站永远直连，不走代理。" />

                                    <TextBlock
                                        x:Name="txtDirectRuleStatus"
                                        Margin="1,6,0,0"
                                        Style="{StaticResource P2rayMicro}"
                                        Foreground="{StaticResource P2rayAccentTextBrush}" />

                                    <ItemsControl x:Name="lstDirectRules" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,4"
                                                    Padding="10,7"
                                                    Background="{StaticResource P2raySurfaceBrush}"
                                                    CornerRadius="{StaticResource P2rayRadiusS}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border
                                                            Grid.Column="0"
                                                            Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource P2rayAccentSoftBrush}"
                                                            CornerRadius="4">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{StaticResource P2rayAccentTextBrush}"
                                                                Text="{Binding KindText}" />
                                                        </Border>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="8,0,8,0"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas, Cascadia Mono, monospace"
                                                            FontSize="{StaticResource P2rayFontCaption}"
                                                            Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                                            Text="{Binding Value}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <Button
                                                            Grid.Column="2"
                                                            Width="48"
                                                            Height="22"
                                                            Click="BtnRemoveDirectRule_Click"
                                                            Content="移除"
                                                            Style="{StaticResource P2raySecondaryButton}"
                                                            Tag="{Binding Id}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 分组：网络位置 ═══ -->
            <!-- 回答两个问题：外面看到我是谁（出口 IP + 归属地），以及常用站点能不能通。
                 布局参考 ip.net.coffee：左侧 IP 大字号，右侧连通性小卡网格。 -->
            <Grid Margin="0,0,0,6">
                <TextBlock Style="{StaticResource P2raySectionLabel}" Text="网络位置" />
                <Button
                    x:Name="btnRefreshNetProbe"
                    HorizontalAlignment="Right"
                    Margin="0,0,6,0"
                    Padding="10,0"
                    Height="22"
                    Click="BtnRefreshNetProbe_Click"
                    Content="重新检测"
                    Style="{StaticResource P2raySecondaryButton}" />
            </Grid>

            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <!-- 左栏固定宽度：评分行最长的组合是
                             "评分 63 良好 住宅 IP · AS979 NetLab Global"，
                             320 能整行放下；再宽会挤掉右侧连通性。 -->
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：两个出口 IP。信息层级靠字号与颜色拉开，
                         不靠背景块 —— 深色卡片里再套深色块只会显得脏。 -->
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <!-- 境外出口：主数据，字号最大 -->
                        <TextBlock
                            x:Name="txtExitLabel"
                            Style="{StaticResource P2rayMicro}"
                            Text="境外出口 IP" />

                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <!-- 国旗：Windows 不渲染旗帜 emoji，用素材位图。
                                 没有素材时 IpFlagUri 为 null，图片自然不占位。 -->
                            <Image
                                x:Name="imgIpFlag"
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock
                                x:Name="txtIpAddress"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontH1}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                Text="—"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="txtIpLocation"
                            Margin="0,4,0,0"
                            Style="{StaticResource P2rayMicro}"
                            TextTrimming="CharacterEllipsis" />

                        <!-- IP 评分紧贴被评的那个 IP —— 之前它单独做成一块浮在下面，
                             既看不出评的是哪个 IP，又在卡片里多出一层背景。 -->
                        <StackPanel
                            x:Name="scorePanel"
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}"
                                Text="评分" />
                            <TextBlock
                                x:Name="txtIpScore"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontH2}"
                                FontWeight="SemiBold"
                                Text="—" />
                            <TextBlock
                                x:Name="txtIpScoreLevel"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}" />
                            <TextBlock
                                x:Name="txtIpMeta"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 国内出口：只在连了代理时出现。
                             用户需要同时看到"我的真实地址"和"代理伪装成的地址"，
                             两者一对比就知道代理到底生效没有。
                             直连状态下它与上面是同一条数据，重复显示反而费解。 -->
                        <Border
                            x:Name="domesticExitPanel"
                            Margin="0,12,0,0"
                            Padding="0,11,0,0"
                            BorderBrush="{StaticResource P2rayDividerBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource P2rayMicro}" Text="国内出口 IP" />
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <Image
                                        x:Name="imgDomesticFlag"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock
                                        x:Name="txtDomesticIpAddress"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas, Cascadia Mono, monospace"
                                        FontSize="{StaticResource P2rayFontH2}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                        Text="—"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="txtDomesticIpLocation"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 分隔线：两栏之间的细线，比空白更清楚地说明"这是两组数据"。
                         HorizontalAlignment=Center 而非 Stretch —— 1px 宽的列里
                         Stretch 会取整成 0，线就消失了。 -->
                    <Border
                        Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{StaticResource P2rayDividerBrush}" />

                    <!-- 中右：连通性 -->
                    <StackPanel Grid.Column="2" Margin="18,0,0,0">
                        <Grid Margin="0,0,0,10">
                            <TextBlock
                                x:Name="txtNetProbeSummary"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}" />
                            <TextBlock
                                x:Name="txtNetProbeStatus"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayMicro}" />
                        </Grid>

                        <!-- 分组列表：每组一个小标题（含本组小计）+ 站点网格。
                             图标是内置资源，断网也能显示 —— 这个面板恰恰是断网时最需要看的。 -->
                        <ItemsControl x:Name="lstNetProbeGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource P2rayFontMicro}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource P2rayTextSecondaryBrush}"
                                                Text="{Binding Tag}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource P2rayMicro}"
                                                Text="{Binding SummaryText}" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 站点行不再一块一底：9 个方块堆在一起是
                                                         界面显得碎的根源。改为图标 + 名称 + 延迟
                                                         三列对齐，靠列宽而不是边框来分组。 -->
                                                    <Grid Margin="0,0,10,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Image
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,7,0"
                                                            VerticalAlignment="Center"
                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                            Source="{Binding IconUri, Converter={x:Static conv:ImageUriConverter.Instance}}" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource P2rayMicro}"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas, Cascadia Mono, monospace"
                                                            FontSize="{StaticResource P2rayFontCaption}"
                                                            Foreground="{Binding State, Converter={x:Static conv:ProbeStateBrushConverter.Instance}}"
                                                            Text="{Binding LatencyText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 探测进行中：占位列表（还没分组），让用户先看到要测哪些站点 -->
                        <ItemsControl x:Name="lstNetProbes">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,10,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding IconUri, Converter={x:Static conv:ImageUriConverter.Instance}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource P2rayMicro}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas, Cascadia Mono, monospace"
                                            FontSize="{StaticResource P2rayFontCaption}"
                                            Foreground="{Binding State, Converter={x:Static conv:ProbeStateBrushConverter.Instance}}"
                                            Text="{Binding LatencyText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 分组：流量 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="流量" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 行：下载 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGreen}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ArrowDownThin" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="下载" />

                            <ctrl:Sparkline
                                x:Name="chartDownload"
                                Grid.Column="2"
                                Height="24"
                                Margin="20,0"
                                VerticalAlignment="Center"
                                Fill="#2230D158"
                                Stroke="{StaticResource P2raySuccessBrush}"
                                Values="{Binding DownloadHistory}" />

                            <TextBlock
                                x:Name="txtDownload"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayH2}"
                                Text="0 B/s" />
                        </Grid>
                    </Border>

                    <!-- 行：上传 -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconBlue}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ArrowUpThin" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="上传" />

                            <TextBlock
                                x:Name="txtUpload"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayH2}"
                                Text="0 B/s" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 分组：订阅 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="订阅" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 订阅列表 -->
                    <ItemsControl x:Name="lstSubscriptions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource P2rayRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Background="{StaticResource P2rayIconPurple}"
                                            Style="{StaticResource P2rayRowIcon}">
                                            <materialDesign:PackIcon
                                                Width="13"
                                                Height="13"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Kind="CloudDownloadOutline" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource P2rayBody}"
                                            Text="{Binding Remarks}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource P2rayMicro}"
                                            Text="{Binding UpdateTime, Converter={x:Static conv:UnixTimeConverter.Instance}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 无订阅时的引导行 -->
                    <StackPanel x:Name="guidePanel">
                        <Border Style="{StaticResource P2rayRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{StaticResource P2rayIconPurple}"
                                    Style="{StaticResource P2rayRowIcon}">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="CloudDownloadOutline" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource P2rayBody}" Text="还没有订阅" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource P2rayMicro}"
                                        Text="从服务商复制一条订阅链接" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="BtnAddSub_Click"
                                    Content="添加"
                                    Style="{StaticResource P2rayPrimaryButton}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 更新全部 -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconBlue}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Refresh" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="更新全部订阅" />

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnUpdateSub_Click"
                                Content="更新"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 分组：线路与运行 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="线路与运行" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 可用线路 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconOrange}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ServerNetwork" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="可用线路" />

                            <TextBlock
                                x:Name="txtNodeCount"
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayCaption}"
                                Text="0 条" />

                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Click="BtnGoNodes_Click"
                                Content="更换"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>

                    <!-- 能否上网 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconTeal}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Earth" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="网络状态" />

                            <TextBlock
                                x:Name="txtInternet"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayCaption}" />
                        </Grid>
                    </Border>

                    <!-- 已连接时长 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGray}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ClockOutline" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="已连接时长" />

                            <TextBlock
                                x:Name="txtRunTime"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayCaption}"
                                Text="—" />
                        </Grid>
                    </Border>

                    <!-- 运行核心 -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGray}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Chip" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="运行核心" />

                            <TextBlock
                                x:Name="txtCoreType"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayCaption}"
                                Text="—" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 分组：本地端口（放到最下方，属于排查信息） ═══ -->
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <Border Style="{StaticResource P2rayRowLast}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="{StaticResource P2rayIconGray}"
                            Style="{StaticResource P2rayRowIcon}">
                            <materialDesign:PackIcon
                                Width="13"
                                Height="13"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="LanConnect" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource P2rayBody}" Text="本地端口" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource P2rayMicro}"
                                Text="其他软件要手动填代理时用这个端口" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="txtLocalPort"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                FontSize="{StaticResource P2rayFontBody}"
                                Foreground="{StaticResource P2rayTextPrimaryBrush}"
                                Text="—" />
                            <Button
                                Margin="8,0,0,0"
                                Padding="10,0"
                                Click="BtnCopyPort_Click"
                                Content="复制"
                                Height="24"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ═══ 运行日志（折叠） ═══ -->
            <Button
                x:Name="btnToggleLog"
                HorizontalAlignment="Left"
                Margin="4,0,0,0"
                Click="BtnToggleLog_Click"
                Content="显示运行日志"
                Style="{StaticResource P2raySecondaryButton}" />

            <Border
                x:Name="logCard"
                Margin="0,10,0,0"
                Style="{StaticResource P2rayCard}"
                Visibility="Collapsed">
                <ContentControl x:Name="msgHost" Margin="12" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
