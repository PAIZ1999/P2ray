<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.SettingsView"
    x:TypeArguments="vms:DashboardViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tr="clr-namespace:v2rayN.Markup"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="820"
    d:DesignWidth="1060"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- macOS 设置页的分组是撑满内容区的，不设 MaxWidth，否则右侧会留一片空 -->
        <StackPanel Margin="24,18,24,28">

            <TextBlock Margin="4,0,0,14" Style="{StaticResource P2rayH1}" Text="{tr:Tr P2NavSettings}" />

            <!-- ═══ 通用 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="{tr:Tr P2SetGeneral}" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 开机自启动 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGreen}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Power" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetAutoRun}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetAutoRunHint}" />
                            </StackPanel>

                            <ToggleButton
                                x:Name="togAutoRun"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TogAutoRun_Click"
                                Style="{StaticResource P2rayToggle}" />
                        </Grid>
                    </Border>

                    <!-- 启动时最小化 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGray}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ArrowDownThin" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetAutoHide}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetAutoHideHint}" />
                            </StackPanel>

                            <ToggleButton
                                x:Name="togAutoHideStartup"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TogAutoHideStartup_Click"
                                Style="{StaticResource P2rayToggle}" />
                        </Grid>
                    </Border>

                    <!-- 自动更新间隔 -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconTeal}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ClockOutline" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetAutoUpdate}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetAutoUpdateHint}" />
                            </StackPanel>

                            <Button
                                x:Name="btnAutoUpdate"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnAutoUpdate_Click"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 网络 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="{tr:Tr P2SetNetwork}" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <!-- 局域网连接 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconBlue}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="LanConnect" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetAllowLan}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetAllowLanHint}" />
                            </StackPanel>

                            <ToggleButton
                                x:Name="togAllowLan"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TogAllowLan_Click"
                                Style="{StaticResource P2rayToggle}" />
                        </Grid>
                    </Border>

                    <!-- UDP 转发 -->
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconPurple}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Earth" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetUdp}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetUdpHint}" />
                            </StackPanel>

                            <ToggleButton
                                x:Name="togUdp"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TogUdp_Click"
                                Style="{StaticResource P2rayToggle}" />
                        </Grid>
                    </Border>

                    <!-- 日志级别 -->
                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconOrange}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="FileDocumentOutline" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetLogLevel}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetLogLevelHint}" />
                            </StackPanel>

                            <Button
                                x:Name="btnLogLevel"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnLogLevel_Click"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 订阅 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="{tr:Tr P2HomeSubs}" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconPurple}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="CloudDownloadOutline" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetSubManage}" />
                                <TextBlock
                                    x:Name="txtSubCount"
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnManageSub_Click"
                                Content="{tr:Tr P2SetManage}"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconBlue}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Refresh" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2HomeUpdateAllSubs}" />
                                <TextBlock
                                    x:Name="txtSubUpdateHint"
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetUpdateSubsHint}" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnUpdateSub_Click"
                                Content="{tr:Tr P2HomeUpdate}"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 高级功能 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="{tr:Tr P2SetCores}" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconBlue}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="HexagonOutline" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="Xray" />
                                <TextBlock
                                    x:Name="txtCoreXray"
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="—" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnOpenCoreDir_Click"
                                Content="{tr:Tr P2SetOpenFolder}"
                                Style="{StaticResource P2raySecondaryButton}"
                                Tag="xray" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconTeal}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="CubeOutline" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="sing-box" />
                                <TextBlock
                                    x:Name="txtCoreSingbox"
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="—" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnOpenCoreDir_Click"
                                Content="{tr:Tr P2SetOpenFolder}"
                                Style="{StaticResource P2raySecondaryButton}"
                                Tag="sing_box" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconPurple}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="HexagonMultipleOutline" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="mihomo" />
                                <TextBlock
                                    x:Name="txtCoreMihomo"
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="—" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnOpenCoreDir_Click"
                                Content="{tr:Tr P2SetOpenFolder}"
                                Style="{StaticResource P2raySecondaryButton}"
                                Tag="mihomo" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconOrange}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Download" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetCheckCoreUpdate}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetCheckCoreUpdateHint}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnCoreUpdate_Click"
                                Content="{tr:Tr P2SetCheck}"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="{tr:Tr P2SetAdvanced}" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <Border Style="{StaticResource P2rayRowLast}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconOrange}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="CogOutline" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="{tr:Tr P2SetConfigRules}" />
                        </Grid>

                        <!-- 原来的顶栏功能收在这里 -->
                        <WrapPanel Margin="32,10,0,0">
                            <Button
                                x:Name="btnCoreSetting"
                                Margin="0,0,8,8"
                                Click="BtnCoreSetting_Click"
                                Content="{tr:Tr P2CoreTitle}"
                                Style="{StaticResource P2raySecondaryButton}" />
                            <Button
                                x:Name="btnRoutingSetting"
                                Margin="0,0,8,8"
                                Click="BtnRouting_Click"
                                Content="{tr:Tr P2SetRouting}"
                                Style="{StaticResource P2raySecondaryButton}" />
                            <Button
                                x:Name="btnDnsSetting"
                                Margin="0,0,8,8"
                                Click="BtnDns_Click"
                                Content="{tr:Tr P2SetDns}"
                                Style="{StaticResource P2raySecondaryButton}" />
                            <Button
                                x:Name="btnFullConfig"
                                Margin="0,0,8,8"
                                Click="BtnFullConfig_Click"
                                Content="{tr:Tr P2SetFullTemplate}"
                                Style="{StaticResource P2raySecondaryButton}" />
                            <Button
                                x:Name="btnHotkey"
                                Margin="0,0,8,8"
                                Click="BtnHotkey_Click"
                                Content="{tr:Tr P2SetHotkey}"
                                Style="{StaticResource P2raySecondaryButton}" />
                            <Button
                                x:Name="btnBackup"
                                Margin="0,0,8,8"
                                Click="BtnBackup_Click"
                                Content="{tr:Tr P2SetBackup}"
                                Style="{StaticResource P2raySecondaryButton}" />
                            <Button
                                x:Name="btnRebootAdmin"
                                Margin="0,0,8,8"
                                Click="BtnRebootAdmin_Click"
                                Content="{tr:Tr P2SetRestartAdmin}"
                                Style="{StaticResource P2raySecondaryButton}" />
                            <Button
                                x:Name="btnClearStat"
                                Margin="0,0,8,8"
                                Click="BtnClearStat_Click"
                                Content="{tr:Tr P2SetClearStats}"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══ 数据 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="{tr:Tr P2SetData}" />
            <Border Margin="0,0,0,16" Style="{StaticResource P2rayCard}">
                <StackPanel>
                                        <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGreen}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ChartTimelineVariant" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetRetention}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetRetentionHint}" />
                            </StackPanel>
                            <Button
                                x:Name="btnRetention"
                                Grid.Column="2"
                                MinWidth="88"
                                VerticalAlignment="Center"
                                Click="BtnRetention_Click"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>
<Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGray}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="FolderOutline" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetProgramDir}" />
                                <TextBlock
                                    x:Name="txtDataDir"
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnOpenDir_Click"
                                Content="{tr:Tr P2SetOpen}"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconTeal}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="FileDocumentOutline" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetLogsBackup}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetLogsBackupHint}" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnOpenLogDir_Click"
                                Content="{tr:Tr P2SetOpen}"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ 关于 ═══ -->
            <TextBlock Style="{StaticResource P2raySectionLabel}" Text="{tr:Tr P2SetAbout}" />
            <Border Style="{StaticResource P2rayCard}">
                <StackPanel>
                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconTeal}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="InformationOutline" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="{tr:Tr P2SetVersion}" />

                            <TextBlock
                                x:Name="txtVersionAbout"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayCaption}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource P2rayRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconGray}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ShieldCheck" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource P2rayBody}" Text="{tr:Tr P2SetLicense}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{tr:Tr P2SetLicenseHint}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource P2rayRowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource P2rayIconOrange}"
                                Style="{StaticResource P2rayRowIcon}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Update" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource P2rayBody}"
                                Text="{tr:Tr P2NavCheckUpdate}" />

                            <Button
                                x:Name="btnCheckUpdate"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnCheckUpdate_Click"
                                Content="{tr:Tr P2SetCheck}"
                                Style="{StaticResource P2raySecondaryButton}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
