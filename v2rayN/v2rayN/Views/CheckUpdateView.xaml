<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.CheckUpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vms:CheckUpdateViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin8}"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">

            <TextBlock
                Margin="{StaticResource Margin8}"
                VerticalAlignment="Center"
                Style="{StaticResource ToolbarTextBlock}"
                Text="{x:Static resx:ResUI.TbSettingsEnableUpdateViaProxy}" />
            <ToggleButton
                x:Name="togEnableUpdateViaProxy"
                Margin="{StaticResource Margin8}"
                HorizontalAlignment="Left" />

            <Button
                x:Name="btnCheckOnly"
                MinWidth="100"
                Margin="{StaticResource Margin8}"
                Content="{x:Static resx:ResUI.menuCheckOnly}"
                Style="{StaticResource DefButton}" />

            <Button
                x:Name="btnCheckUpdate"
                MinWidth="100"
                Margin="{StaticResource Margin8}"
                Content="{x:Static resx:ResUI.menuCheckAndUpdate}"
                IsDefault="True"
                Style="{StaticResource DefButton}" />
        </StackPanel>

        <StackPanel>
            <!-- 背景透明：不设的话 ListView 会用系统默认的白色底，
                 在深色主题里就是一块突兀的白板。 -->
            <ListView
                x:Name="lstCheckUpdates"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource lvItemSelected}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- 不再写死 Width=660。固定宽度在窗口拉宽后会让内容浮在
                             左侧、右侧一片空，而四列 1*/2*/1*/3* 等比分配又会把
                             "Pre-Release" 那格撑得过大。改为占满可用宽度 + Auto 列。 -->
                        <Border Margin="0,1" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton
                                    Grid.Column="0"
                                    Width="36"
                                    Height="20"
                                    Margin="4,0,10,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsSelected}" />

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding ShowCheckPreRelease, Converter={StaticResource BoolToVisConverter}}">
                                    <ToggleButton
                                        Width="36"
                                        Height="20"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsCheckPreRelease}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource P2rayMicro}"
                                        Text="Pre-Release" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="80"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource P2rayBody}"
                                    Text="{Binding CoreTypeForStorage}" />

                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource P2rayMicro}"
                                    Text="{Binding Remarks}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </DockPanel>
</reactiveui:ReactiveUserControl>
