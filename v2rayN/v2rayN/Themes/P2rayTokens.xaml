<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        P2ray 设计令牌 —— macOS 系统设置风格

        macOS 的主要特征：
        1. 分组卡片：多条设置项合并进一张卡片，行间用细线分隔，而不是一项一卡
        2. 每行左侧带彩色圆角图标，用于快速识别
        3. 字号差很小（11/13px），靠字重与颜色区分层级，不靠大小
        4. 卡片背景比页面背景略亮，边框几乎不可见
        5. 系统蓝 #0A84FF 作为强调色

        所有颜色硬编码。DynamicResource 解析失败会静默退化为默认值。
    -->

    <!-- ===================== 背景层次 ===================== -->
    <!-- 窗口底 -->
    <SolidColorBrush x:Key="P2rayBgBrush" Color="#1C1C1E" />
    <!-- 分组卡片 -->
    <SolidColorBrush x:Key="P2raySurfaceBrush" Color="#2C2C2E" />
    <!-- 卡片内行悬停 -->
    <SolidColorBrush x:Key="P2rayElevatedBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="P2rayHoverBrush" Color="#3A3A3C" />
    <!-- 侧栏（略深于内容区） -->
    <SolidColorBrush x:Key="P2raySidebarBrush" Color="#232325" />
    <SolidColorBrush x:Key="P2rayGlassBrush" Color="#F02C2C2E" />

    <!-- ===================== 强调色：系统蓝 ===================== -->
    <SolidColorBrush x:Key="P2rayAccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="P2rayAccentHoverBrush" Color="#3D9BFF" />
    <SolidColorBrush x:Key="P2rayAccentPressedBrush" Color="#0066CC" />
    <SolidColorBrush x:Key="P2rayAccentSoftBrush" Color="#330A84FF" />
    <SolidColorBrush x:Key="P2rayAccentTextBrush" Color="#4FA8FF" />

    <LinearGradientBrush x:Key="P2rayAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0A84FF" />
        <GradientStop Offset="1" Color="#0066CC" />
    </LinearGradientBrush>

    <!-- ===================== 文字 ===================== -->
    <SolidColorBrush x:Key="P2rayTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="P2rayTextSecondaryBrush" Color="#B0B0B5" />
    <SolidColorBrush x:Key="P2rayTextTertiaryBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="P2rayTextDisabledBrush" Color="#5A5A5E" />

    <!-- ===================== 分隔与描边 ===================== -->
    <!-- macOS 卡片几乎不用边框，靠背景差；分隔线很淡 -->
    <SolidColorBrush x:Key="P2rayBorderBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="P2rayDividerBrush" Color="#3A3A3C" />

    <!-- ===================== 语义色（macOS 系统色） ===================== -->
    <SolidColorBrush x:Key="P2raySuccessBrush" Color="#30D158" />
    <SolidColorBrush x:Key="P2raySuccessSoftBrush" Color="#1A30D158" />
    <SolidColorBrush x:Key="P2rayWarningBrush" Color="#FF9F0A" />
    <SolidColorBrush x:Key="P2rayDangerBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="P2rayIdleBrush" Color="#636366" />

    <!-- 图标底色（macOS 设置里每行图标的彩色底） -->
    <SolidColorBrush x:Key="P2rayIconBlue" Color="#0A84FF" />
    <SolidColorBrush x:Key="P2rayIconGreen" Color="#30D158" />
    <SolidColorBrush x:Key="P2rayIconOrange" Color="#FF9F0A" />
    <SolidColorBrush x:Key="P2rayIconPurple" Color="#BF5AF2" />
    <SolidColorBrush x:Key="P2rayIconGray" Color="#8E8E93" />
    <SolidColorBrush x:Key="P2rayIconRed" Color="#FF453A" />
    <SolidColorBrush x:Key="P2rayIconTeal" Color="#40C8E0" />

    <!-- ===================== 尺度 ===================== -->
    <!-- macOS 字号区间窄：11 / 13 / 17 / 22 -->
    <sys:Double x:Key="P2rayFontDisplay">22</sys:Double>
    <sys:Double x:Key="P2rayFontH1">17</sys:Double>
    <sys:Double x:Key="P2rayFontH2">13</sys:Double>
    <sys:Double x:Key="P2rayFontBody">13</sys:Double>
    <sys:Double x:Key="P2rayFontCaption">12</sys:Double>
    <sys:Double x:Key="P2rayFontMicro">11</sys:Double>

    <sys:Double x:Key="P2raySidebarWidth">208</sys:Double>
    <sys:Double x:Key="P2rayNavItemHeight">32</sys:Double>

    <!-- 卡片 10px、图标底 6px、控件 6px -->
    <CornerRadius x:Key="P2rayRadiusS">6</CornerRadius>
    <CornerRadius x:Key="P2rayRadiusM">10</CornerRadius>
    <CornerRadius x:Key="P2rayRadiusL">10</CornerRadius>
    <CornerRadius x:Key="P2rayRadiusPill">999</CornerRadius>

    <Thickness x:Key="P2rayPagePadding">20</Thickness>
    <Thickness x:Key="P2rayCardPadding">0</Thickness>
    <Thickness x:Key="P2raySectionGap">0,0,0,16</Thickness>

    <!-- ===================== 分组卡片 ===================== -->
    <!-- macOS 卡片：无边框、浅背景、行间分隔由行自己画 -->
    <Style x:Key="P2rayCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource P2raySurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource P2rayRadiusM}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="P2rayGlass" TargetType="{x:Type Border}" BasedOn="{StaticResource P2rayCard}">
        <Setter Property="Background" Value="{StaticResource P2rayGlassBrush}" />
    </Style>

    <!-- 分组标题：卡片上方的小字 -->
    <Style x:Key="P2raySectionLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource P2rayFontMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextTertiaryBrush}" />
        <Setter Property="Margin" Value="14,0,0,6" />
    </Style>

    <!-- ===================== 设置行 ===================== -->
    <!-- 一行 = 左图标 + 标题 + 右侧控件，底部细线 -->
    <Style x:Key="P2rayRow" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource P2rayDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- 分组内最后一行：不画线 -->
    <Style x:Key="P2rayRowLast" TargetType="{x:Type Border}" BasedOn="{StaticResource P2rayRow}">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 行内彩色图标底 -->
    <Style x:Key="P2rayRowIcon" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="{StaticResource P2rayRadiusS}" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== 排版 ===================== -->
    <Style x:Key="P2rayDisplay" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource P2rayFontDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="P2rayH1" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource P2rayFontH1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="P2rayH2" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource P2rayFontH2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
    </Style>

    <Style x:Key="P2rayBody" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource P2rayFontBody}" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
    </Style>

    <Style x:Key="P2rayCaption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource P2rayFontCaption}" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextSecondaryBrush}" />
    </Style>

    <Style x:Key="P2rayMicro" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource P2rayFontMicro}" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextTertiaryBrush}" />
    </Style>

    <!-- ===================== 按钮 ===================== -->
    <!-- macOS 主按钮：系统蓝、圆角 6、中等高度 -->
    <Style x:Key="P2rayPrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource P2rayAccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS 次按钮：浅灰底、无边框 -->
    <Style x:Key="P2raySecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontBody}" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource P2rayElevatedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#48484A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作按钮（连接）：macOS 强调色实心 -->
    <Style x:Key="P2rayConnectButton" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontH2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource P2rayAccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayAccentPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 断开按钮：浅灰底，与连接按钮形成主次 -->
    <Style x:Key="P2rayDisconnectButton" TargetType="{x:Type Button}" BasedOn="{StaticResource P2rayConnectButton}">
        <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource P2rayElevatedBrush}" />
    </Style>

    <!-- ===================== 侧栏导航 ===================== -->
    <!-- macOS 侧栏：选中项是蓝色圆角块，文字变白 -->
    <Style x:Key="P2rayNavItem" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="{StaticResource P2rayNavItemHeight}" />
        <Setter Property="Margin" Value="10,1" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontH2}" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="Bg"
                        Background="Transparent"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter Margin="10,0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayAccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 开关（圆角长方形轨道） ===================== -->
    <!-- 不用胶囊：44×20 的圆角矩形（半径 4），滑块是 14×14 的小圆角方块。
         宽高比 2.2:1 且圆角绝对值小，视觉上是"长方形"而不是"椭圆"。
         滑块靠 Margin 定位而非 HorizontalAlignment，左右位移对称，不会贴边。 -->
    <Style x:Key="P2rayToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="Track"
                        Background="#3A3A3C"
                        BorderBrush="#4A4A4E"
                        BorderThickness="1"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <Border
                            x:Name="Knob"
                            Width="14"
                            Height="14"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Left"
                            Background="#DCDCE0"
                            CornerRadius="2" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#4A4A4E" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#5E5E62" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource P2raySuccessBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#4FDD74" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="Knob" Property="Background" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="P2rayLogToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontMicro}" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="Bg"
                        Padding="10,0"
                        Background="{StaticResource P2rayElevatedBrush}"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayAccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource P2rayAccentTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 顶栏菜单 ===================== -->
    <!-- macOS 工具栏：扁平、悬停才出现浅底 -->
    <Style x:Key="P2rayToolbarMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource P2rayTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border
                        x:Name="Bg"
                        Padding="9,4"
                        Background="Transparent"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayElevatedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="P2rayToolbarMenuHost" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Menu}">
                    <Border Background="Transparent">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource P2rayToolbarMenuItem}" />
    </Style>

    <!-- 侧栏幽灵按钮：透明底，悬停才显色 -->
    <Style x:Key="NavGhostButton" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Bg"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2raySurfaceBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 列表行（节点） ===================== -->
    <Style x:Key="P2rayListRow" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        x:Name="Bg"
                        Margin="0,1"
                        Padding="12,8"
                        Background="Transparent"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 下拉框（macOS 弹出按钮风格） ===================== -->
    <!-- 行内控件：浅灰底、圆角 6、右侧小箭头。展开的列表单独用 P2rayComboBoxItem -->
    <Style x:Key="P2rayComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontBody}" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border
                        x:Name="Bg"
                        Margin="4,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P2rayAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="P2rayComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontBody}" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource P2rayElevatedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource P2rayComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <!-- 底：圆角矩形 + 当前选中项 + 箭头 -->
                        <Border
                            x:Name="Bg"
                            Background="{StaticResource P2rayElevatedBrush}"
                            CornerRadius="{StaticResource P2rayRadiusS}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="10,0,4,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    IsHitTestVisible="False" />

                                <materialDesign:PackIcon
                                    Grid.Column="1"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource P2rayTextSecondaryBrush}"
                                    Kind="ChevronDown" />
                            </Grid>
                        </Border>

                        <!-- 透明按钮盖在整块上，负责展开；点击区域比只点箭头大得多 -->
                        <ToggleButton
                            x:Name="DropDownToggle"
                            Background="Transparent"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade">
                            <Border
                                MinWidth="{TemplateBinding ActualWidth}"
                                Margin="0,4,0,0"
                                Padding="0,4"
                                Background="{StaticResource P2raySurfaceBrush}"
                                BorderBrush="{StaticResource P2rayBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource P2rayRadiusM}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#48484A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 分段控件（代理模式切换） ===================== -->
    <!-- macOS segmented control：一整条灰色轨道，选中段是轨道内抬起的一块。
         关键点是"整体是一个控件"，不是三个并排按钮 —— 并排按钮各自包一圈底，
         宽度随文字长短变化，看上去永远参差。这里由调用方用 UniformGrid 均分。 -->
    <Style x:Key="P2raySegmentTrack" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="#252527" />
        <Setter Property="CornerRadius" Value="{StaticResource P2rayRadiusM}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="P2raySegment" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="{StaticResource P2rayFontCaption}" />
        <Setter Property="Foreground" Value="{StaticResource P2rayTextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="Bg"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource P2rayRadiusS}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#333336" />
                            <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#4A4A4D" />
                            <Setter Property="Foreground" Value="{StaticResource P2rayTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
